declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Hyva\Theme\ViewModel\StoreConfig;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

// This is the reCaptcha script loader (for v2 and v3)

/** @var $storeConfig StoreConfig */
$storeConfig        = $viewModels->require(StoreConfig::class);
$siteKeyV3          = (string) $storeConfig->getStoreConfig('recaptcha_frontend/type_recaptcha_v3/public_key');
$siteKeyV2checkbox  = (string) $storeConfig->getStoreConfig('recaptcha_frontend/type_recaptcha/public_key');
$siteKeyV2invisible = (string) $storeConfig->getStoreConfig('recaptcha_frontend/type_invisible/public_key');

if (!$siteKeyV2checkbox && !$siteKeyV2invisible && !$siteKeyV3) {
    // No v2 or v3 google API credentials configured, skip rendering the loader
    return;
}
?>
<script>
    const grecaptchaV2LoadCallbacks = [];

    function executeRecaptchaLoadCallbacks () {
        while (window.grecaptcha && grecaptchaV2LoadCallbacks.length > 0) {
            const callback = grecaptchaV2LoadCallbacks.pop();
            typeof callback === 'string' ? window[callback]() : callback();
        }
    }

    (() => {
        const recaptchaFieldSelector = '.g-recaptcha, [data-recaptcha], [name="g-recaptcha-response"]';
        const interactionEvents = ['focusin', 'input'];
        let isScriptRequested = false;

        const loadRecaptchaScript = () => {
            if (window.grecaptcha || isScriptRequested) return;

            isScriptRequested = true;
            interactionEvents.forEach(type => document.removeEventListener(type, onFormInteraction, true));

            const url = 'https://www.google.com/recaptcha/api.js?onload=executeRecaptchaLoadCallbacks';
            const siteKey = '<?= $escaper->escapeJs($siteKeyV3) /* will be empty if only v2 is configured, which is okay */ ?>';
            const script = document.createElement('script');
            script.type = 'text/javascript';
            script.src = siteKey ? `${url}&render=${siteKey}` : `${url}&render=explicit`;
            script.async = true;
            document.head.appendChild(script);

            script.addEventListener('load', () => {
                Array.from(document.querySelectorAll('button[data-recaptcha-btn]:disabled')).forEach(btn => btn.removeAttribute('disabled'));
            });
        };

        /**
         * Load the reCAPTCHA script on the first interaction with a form that contains a reCAPTCHA field.
         *
         * @param {Event} event
         */
        const onFormInteraction = (event) => {
            if (!event.target.form?.querySelector(recaptchaFieldSelector)) return;

            loadRecaptchaScript();
        };

        window.forceLoadRecaptchaScript = () => {
            loadRecaptchaScript();
            executeRecaptchaLoadCallbacks();
        };

        interactionEvents.forEach(type => document.addEventListener(type, onFormInteraction, true));
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
