declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPage;
use Hyva\Theme\ViewModel\ProductPrice;
use Magento\Catalog\Pricing\Price\FinalPrice;
use Magento\Msrp\Pricing\Render\PriceBox;
use Magento\Framework\Escaper;
use Magento\Msrp\Pricing\Price\MsrpPriceInterface;
use Magento\Catalog\Model\Product;
use Magento\Framework\Pricing\Render as PricingRender;

/** @var PriceBox $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var MsrpPriceInterface $priceType */
$priceType = $block->getPrice();

/** @var Product $product  */
$product = $block->getSaleableItem();
$productId = $product->getId();

$amount = $block->getMsrpPriceCalculator()->getMsrpPriceValue($product);

$msrpPrice = $block->renderAmount(
    $priceType->getCustomAmount($amount),
    [
        'price_id' => $block->getPriceId() ? $block->getPriceId() : 'old-price-' . $productId,
        'include_container' => false,
        'skip_adjustments' => true
    ]
);
$priceElementIdPrefix = $block->getPriceElementIdPrefix() ?: 'product-price-';


$msrpData = [
    'type' => 'price',
    'productId' => $productId,
    'productName' => $product->getName(),
    'productIdInput' => '',
    'isSaleable' => (bool) $product->isSaleable(),
    'realPrice' => $block->getRealPriceHtml(),
    'msrpPrice' => $msrpPrice
];

?>

<?php if ($amount): ?>
    <span class="map-old-price old-price inline-block"><?= /* @noEscape */ $msrpPrice ?></span>
    <span class="map-fallback-price normal-price hidden"><?= /* @noEscape */ $msrpPrice ?></span>
<?php endif; ?>
<?php if ($priceType->isShowPriceOnGesture()): ?>
    <button
        type="button"
        class="underline hover:no-underline"
        x-data="initMsrpPrice"
        @click="onClick"
        data-msrp-data="<?= $escaper->escapeHtmlAttr(json_encode($msrpData)) ?>"
    >
        <?= $escaper->escapeHtml(__('Click for price')) ?>
    </button>
<?php else: ?>
    <div class="msrp-message message notice message-notice my-2 py-2 px-3 text-xs">
        <?= $escaper->escapeHtml($priceType->getMsrpPriceMessage()) ?>
    </div>
<?php endif; ?>

<?php if ($block->getZone() == PricingRender::ZONE_ITEM_VIEW): ?>
    <?php
    /** @var ProductPrice $productPriceViewModel */
    $productPriceViewModel = $viewModels->require(ProductPrice::class);
    /** @var ProductPage $productViewModel */
    $productViewModel = $viewModels->require(ProductPage::class);
    $priceValidUntil = $product->getSpecialToDate();
    ?>
    <?php /* The actual price stays hidden on the page, but crawlers still need it in the structured data */ ?>
    <div itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <meta
            itemprop="price"
            content="<?= $escaper->escapeHtmlAttr($productPriceViewModel->getPriceValue(FinalPrice::PRICE_CODE, $product)) ?>"
        >
        <meta itemprop="priceCurrency" content="<?= $escaper->escapeHtmlAttr($productViewModel->getCurrencyData()['code']) ?>">
        <?php if ($priceValidUntil): ?>
            <meta
                itemprop="priceValidUntil"
                content="<?= $escaper->escapeHtmlAttr(date('Y-m-d', strtotime($priceValidUntil))) ?>"
            >
        <?php endif; ?>
        <link
            itemprop="availability"
            href="<?= $escaper->escapeHtmlAttr($product->getIsSalable() ? 'http://schema.org/InStock' : 'http://schema.org/OutOfStock') ?>"
        >
    </div>
    <?php /* "Click for price" already shows the same explanation, so only offer it when the price is not shown on click */ ?>
    <?php if (! $priceType->isShowPriceOnGesture()): ?>
        <button
            type="button"
            class="underline hover:no-underline"
            x-data="initMsrpPrice"
            @click="onClick"
            data-msrp-data="<?= $escaper->escapeHtmlAttr(json_encode(['type' => 'help'])) ?>"
        >
            <?= $escaper->escapeHtml(__("What's this?")) ?>
        </button>
    <?php endif; ?>
<?php endif; ?>
