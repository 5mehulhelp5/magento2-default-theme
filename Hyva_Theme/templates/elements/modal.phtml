declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$cssClasses = $block->getCssClasses() ?: 'modal';
$btnCssClasses = $block->getBtnCssClasses() ?: 'btn';

/** @deprecated use `'close_by' 'any'` instead of `close_on_backdrop` */
$closeOnBackdrop = $block->getCloseOnBackdrop() ?? true;

$modalBtnLabel = $block->getModalBtnLabel() ?: 'Open Modal';
$closeBy = $block->getCloseBy() ?: ($closeOnBackdrop ? 'any' : null);
?>

<div x-data="hyvaModal">
    <button @click="open" class="<?= $escaper->escapeHtmlAttr($btnCssClasses) ?>">
        <?= $escaper->escapeHtml(__($modalBtnLabel)); ?>
    </button>
    <dialog
        class="<?= $escaper->escapeHtmlAttr($cssClasses) ?>"
        x-show="isOpen"
        x-transition
        x-htmldialog="close"
        <?php if ($closeBy): ?>
            closeby="<?= $escaper->escapeHtmlAttr($closeBy) ?>"
        <?php endif; ?>
    >
        <?= $block->getChildHtml() ?>
    </dialog>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('hyvaModal', () => ({
            isOpen: false,
            open() {
                this.isOpen = true;
            },
            close() {
                this.isOpen = false;
            },
        }));
    });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
