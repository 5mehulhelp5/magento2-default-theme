declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$blockId = $block->getBlockId() ?: 'collapsible';
$blockClass = $block->getBlockCss();
$blockTitle = $block->getBlockTitle() ?: __('Details');
$isNav = $block->getIsNav() !== null ? $block->getIsNav() : false;
?>

<div
    class="card py-2 px-8 mb-6 <?= $escaper->escapeHtmlAttr($blockClass) ?>"
    x-data="initAccountNavigation"
    x-bind="eventListeners"
>
    <button
        type="button"
        id="<?= $escaper->escapeHtmlAttr($blockId) ?>-title"
        class="group py-2 flex justify-between items-center w-full text-start md:cursor-text md:select-text"
        @click="toggleOpen"
        aria-controls="<?= $escaper->escapeHtmlAttr($blockId) ?>"
        :aria-expanded="isOpen"
        :disabled="isNotMobile"
    >

        <span class="text-lg">
            <?= $escaper->escapeHtml($blockTitle) ?>
        </span>
        <span
            class="px-1 py-1 border rounded border-gray-300 md:hidden"
            x-ref="AccountNavigationMobileToggleIcon"
        >
            <?= $lucideIcons->chevronDownHtml(
                'transition-transform duration-300 ease-in-out transform group-aria-expanded:rotate-180',
                24,
                24,
                ['aria-hidden' => 'true']
            ); ?>
        </span>
    </button>
    <?php if ($isNav): ?>
        <nav
            id="<?= $escaper->escapeHtmlAttr($blockId) ?>"
            aria-labelledby="<?= $escaper->escapeHtmlAttr($blockId) ?>-title"
            class="hidden md:block data-[open=true]:block border-t pt-3 my-2 border-gray-300"
            :data-open="isOpen"
        >
            <?= $block->getChildHtml() ?>
        </nav>
    <?php else: ?>
        <div
            id="<?= $escaper->escapeHtmlAttr($blockId) ?>"
            class="hidden md:block data-[open=true]:block border-t pt-3 my-2 border-gray-300"
            :data-open="isOpen"
        >
            <?= $block->getChildHtml() ?>
        </div>
    <?php endif; ?>
</div>
<script>
    function initAccountNavigation() {
        return {
            isMobile: false,
            isOpen: false,
            init() {
                this.checkIsMobileResolution();
            },
            isNotMobile() {
                return !this.isMobile;
            },
            toggleOpen() {
                this.isOpen = !this.isOpen;
            },
            checkIsMobileResolution() {
                const mobileElement = this.$refs.AccountNavigationMobileToggleIcon;
                this.isMobile = mobileElement
                    ? getComputedStyle(mobileElement).display !== 'none'
                    : window.matchMedia('(max-width: 767px)').matches; // Fallback to `md` breakpoint
            },
            eventListeners: {
                ['@resize.window.debounce']() {
                    this.checkIsMobileResolution();
                },
                ['@visibilitychange.window.debounce']() {
                    this.checkIsMobileResolution();
                }
            }
        }
    }
</script>
