       class="mt-3 md:-mt-1 md:ml-auto w-fit btn btn-secondary"
       target="_blank"
       rel="noopener">
        <?= $lucideIcons->printerHtml('mr-1 inline-block', 24, 24, ['aria-hidden' => 'true']); ?>
        <?= $escaper->escapeHtml(__('Print receipt')) ?>
    </a>
    <?= $block->getChildHtml() ?>
<?php endif;?>
