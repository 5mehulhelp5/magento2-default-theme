use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Customer\ReviewList;
use Hyva\Theme\ViewModel\LucideIcons;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Framework\Escaper;
use Magento\Review\Block\Customer\ListCustomer;

/** @var ListCustomer $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

/** @var ReviewList $viewModelCustomerReviews */
$viewModelCustomerReviews = $viewModels->require(ReviewList::class);

/** @var ProductPage $viewModelProductPage */
$viewModelProductPage = $viewModels->require(ProductPage::class);

// The collection is loaded and paginated by the block, so the items are the current page only.
$reviews = $block->getReviews() ? $block->getReviews()->getItems() : [];
$products = $viewModelCustomerReviews->getProductsForReviews($reviews);

$ratingSteps = 5;
$starIconSize = $block->getData('rating_icon_size') ?: 24;
?>
<div class="mb-6 text-2xl"><?= $escaper->escapeHtml(__('My Product Reviews')) ?></div>

<div id="content">
    <?php if ($reviews): ?>
        <?php foreach ($reviews as $review): ?>
            <?php
            $product = $products[(int) $review->getReviewId()] ?? null;
            $productName = (string) $review->getName();
            $productUrl = $block->getProductUrl($review);
            $ratingCount = (int) $review->getCount();
            $starsFilled = $ratingCount
                ? (int) floor((int) $review->getSum() / $ratingCount / 100 * $ratingSteps)
                : 0;
            $ratingLabel = __('%1 rating. %2 out of %3 stars', $productName, $starsFilled, $ratingSteps);
            ?>
            <div class="flex my-6 card">
                <?php if ($product): ?>
                    <div class="w-32 shrink-0">
                        <a href="<?= $escaper->escapeUrl($productUrl) ?>" tabindex="-1" aria-hidden="true">
                            <?= $viewModelProductPage
                                ->getImage($product, 'customer_account_product_review_page')
                                ->toHtml() ?>
                        </a>
                    </div>
                <?php endif ?>
                <div class="ps-6">
                    <p class="text-lg font-medium">
                        <a href="<?= $escaper->escapeUrl($productUrl) ?>">
                            <?= $escaper->escapeHtml($productName) ?>
                        </a>
                    </p>
                    <p class="mb-2 text-sm">
                        <?= $escaper->escapeHtml(__('Created at')) ?>
                        <?= $escaper->escapeHtml($block->dateFormat($review->getReviewCreatedAt())) ?>
                    </p>
                    <?php if ($ratingCount): ?>
                        <div class="rating-summary" role="img"
                             aria-label="<?= $escaper->escapeHtmlAttr($ratingLabel) ?>">
                            <?php for ($i = 0; $i < $ratingSteps; $i++): ?>
                                <?= $lucideIcons->starHtml(
                                    $i < $starsFilled ? 'fill-current' : '',
                                    $starIconSize,
                                    $starIconSize,
                                    ['aria-hidden' => 'true']
                                ) ?>
                            <?php endfor ?>
                        </div>
                    <?php endif ?>
                    <div class="mt-1 leading-relaxed">
                        <p class="font-semibold"><?= $escaper->escapeHtml($review->getTitle()) ?></p>
                        <p><?= /* @noEscape */ nl2br($escaper->escapeHtml($review->getDetail())) ?></p>
                    </div>
                </div>
            </div>
        <?php endforeach ?>
        <?php if ($toolbarHtml = $block->getToolbarHtml()): ?>
            <div class="toolbar review-toolbar mt-4">
                <?= /* @noEscape */ $toolbarHtml ?>
            </div>
        <?php endif ?>
    <?php else: ?>
        <p><?= $escaper->escapeHtml(__('You have submitted no reviews.')) ?></p>
    <?php endif ?>
</div>
