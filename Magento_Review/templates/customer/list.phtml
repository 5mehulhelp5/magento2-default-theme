use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Review\Block\Customer\ListCustomer;

/** @var ListCustomer $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

// The collection is loaded and paginated by the block, so these are the items of the current page only.
$reviews = $block->getReviews() ? $block->getReviews()->getItems() : [];

$ratingSteps = 5;
$starIconSize = $block->getData('rating_icon_size') ?: 20;
?>
<h2 id="my-reviews-title" class="text-2xl mb-6"><?= $escaper->escapeHtml(__('My Product Reviews')) ?></h2>
<?php if ($reviews): ?>
    <div class="overflow-x-auto card mb-4">
        <table id="my-reviews-table" class="w-full" aria-labelledby="my-reviews-title">
            <thead class="text-sm">
                <tr>
                    <th class="p-2 text-start hidden lg:table-cell"><?= $escaper->escapeHtml(__('Created')) ?></th>
                    <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Product Name')) ?></th>
                    <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Rating')) ?></th>
                    <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Review')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($reviews as $review): ?>
                    <?php
                    $productName = (string) $review->getName();
                    $createdAt = $block->dateFormat($review->getReviewCreatedAt());
                    $ratingCount = (int) $review->getCount();
                    $starsFilled = $ratingCount
                        ? (int) floor((int) $review->getSum() / $ratingCount / 100 * $ratingSteps)
                        : 0;
                    $ratingLabel = __('%1 out of %2 stars', $starsFilled, $ratingSteps);
                    ?>
                    <tr class="align-top even:bg-gray-100">
                        <td class="p-2 hidden lg:table-cell whitespace-nowrap">
                            <?= $escaper->escapeHtml($createdAt) ?>
                        </td>
                        <th class="p-2 text-start font-normal">
                            <a class="underline" href="<?= $escaper->escapeUrl($block->getProductUrl($review)) ?>">
                                <?= $escaper->escapeHtml($productName) ?>
                            </a>
                            <p class="lg:hidden text-sm"><?= $escaper->escapeHtml($createdAt) ?></p>
                        </th>
                        <td class="p-2">
                            <?php if ($ratingCount): ?>
                                <div class="rating-summary flex" role="img"
                                     aria-label="<?= $escaper->escapeHtmlAttr($ratingLabel) ?>">
                                    <?php for ($i = 0; $i < $ratingSteps; $i++): ?>
                                        <?= $lucideIcons->starHtml(
                                            $i < $starsFilled ? 'fill-current' : '',
                                            $starIconSize,
                                            $starIconSize,
                                            ['aria-hidden' => 'true']
                                        ) ?>
                                    <?php endfor ?>
                                </div>
                            <?php endif ?>
                        </td>
                        <td class="p-2">
                            <p class="font-semibold"><?= $escaper->escapeHtml($review->getTitle()) ?></p>
                            <p><?= /* @noEscape */ nl2br($escaper->escapeHtml($review->getDetail())) ?></p>
                        </td>
                    </tr>
                <?php endforeach ?>
            </tbody>
        </table>
    </div>
    <?php if ($toolbarHtml = $block->getToolbarHtml()): ?>
        <div class="review-products-toolbar toolbar bottom">
            <?= /* @noEscape */ $toolbarHtml ?>
        </div>
    <?php endif ?>
<?php else: ?>
    <p><?= $escaper->escapeHtml(__('You have submitted no reviews.')) ?></p>
<?php endif ?>
